NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://h3_videoops:h3_videoops@127.0.0.1:5432/h3_videoops
# Local development bearer token. Fine as-is on your own machine; change it
# if the API is ever reachable from anywhere else.
DEV_AUTH_TOKEN=dev-token
ARTIFACT_ROOT=.data/artifacts
COMFY_MODE=fake
COMFY_BASE_URL=http://127.0.0.1:8188
COMFY_WS_URL=ws://127.0.0.1:8188/ws
COMFY_FRONTEND_URL=http://127.0.0.1:8188
COMFY_AUTH_TOKEN=
COMFY_REQUEST_TIMEOUT_MS=15000
COMFY_CLIENT_ID_PREFIX=h3-dev
GPU_WORKER_ID=local-worker-1
# faux (default) needs no key and makes no network call. To run the
# operator's per-incident findings through a real model, set:
#   PI_PROVIDER=deepseek
#   PI_MODEL=deepseek-v4-flash
#   PI_BASE_URL=            (leave empty; the catalog supplies it)
# and either PI_API_KEY or DEEPSEEK_API_KEY below.
PI_PROVIDER=faux
PI_MODEL=h3-videoops-operator-v1
PI_MAX_CONCURRENT_RUNS=1
PI_API_KEY=
PI_BASE_URL=
# Fallback for PI_API_KEY when PI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
ATTEMPT_LEASE_SECONDS=60
ATTEMPT_TIMEOUT_SECONDS=300
PROJECT_DEFAULT_BUDGET_USD=25.00
OTEL_EXPORTER_OTLP_ENDPOINT=
NOTIFY_WEBHOOK_URL=
NOTIFY_TIMEOUT_MS=5000
FAKE_COMFY_HOST=127.0.0.1
FAKE_COMFY_PORT=8188
WEB_HOST=127.0.0.1
WEB_PORT=5173
POSTGRES_PORT=5432
POSTGRES_DB=h3_videoops
POSTGRES_USER=h3_videoops
POSTGRES_PASSWORD=h3_videoops
