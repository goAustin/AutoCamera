{
  "name": "h3-videoops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prerequisites": "node --experimental-strip-types scripts/prerequisites.ts",
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -b tsconfig.json && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -b tsconfig.json && pnpm --filter @h3/web build",
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/compose.yaml up -d postgres",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f postgres",
    "db:migrate": "pnpm --filter @h3/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
