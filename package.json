{
  "name": "h3-videoops",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prerequisites": "node --experimental-strip-types scripts/prerequisites.ts",
    "setup:local": "bash scripts/setup/local.sh",
    "setup:gpu": "bash scripts/setup/gpu-local.sh",
    "setup:rented": "bash scripts/setup/gpu-rented.sh",
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -b tsconfig.json && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node --experimental-strip-types scripts/test-e2e.ts",
    "test:comfy-live": "node --experimental-strip-types scripts/test-comfy-live.ts",
    "comfy:frontend": "bash scripts/fetch-comfy-frontend.sh",
    "comfy:capture-object-info": "node --experimental-strip-types scripts/capture-object-info.ts",
    "demo:seed": "node --experimental-strip-types scripts/demo.ts seed",
    "demo:run": "node --experimental-strip-types scripts/demo.ts run",
    "demo:reset": "node --experimental-strip-types scripts/demo.ts reset",
    "demo:screenshots": "CAPTURE_EVIDENCE=1 node --experimental-strip-types scripts/test-e2e.ts e2e/demo-screenshots.spec.ts",
    "docs:check": "node --experimental-strip-types scripts/validate-docs.ts",
    "security:scan": "node --experimental-strip-types scripts/scan-secrets.ts",
    "observability:up": "docker compose -f infra/compose.yaml --profile observability up -d otel-collector tempo prometheus grafana",
    "observability:down": "docker compose -f infra/compose.yaml --profile observability stop otel-collector tempo prometheus grafana",
    "observability:config": "node --experimental-strip-types scripts/validate-observability.ts",
    "build": "tsc -b tsconfig.json && pnpm --filter @h3/web build",
    "clean": "node --experimental-strip-types scripts/clean.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/compose.yaml up -d postgres",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f postgres",
    "db:migrate": "pnpm --filter @h3/db migrate",
    "media:fixture": "node --experimental-strip-types scripts/generate-fixture.ts",
    "release:verify": "pnpm check && pnpm test:integration && pnpm test:e2e && pnpm test:comfy-live && pnpm observability:config && pnpm security:scan && pnpm docs:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
